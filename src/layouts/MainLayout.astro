---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** 规范链接，用于 canonical 与 og:url（建议绝对 URL） */
  canonicalUrl?: string;
  /** 仅文章页传 'article'，默认 'website' */
  ogType?: 'website' | 'article';
  /** 文章发布时间，ISO 8601 */
  publishedTime?: string;
  /** 文章修改时间，ISO 8601 */
  modifiedTime?: string;
  /** 追加到 body 的 class，用于页面级主题（如阅读页 reading-page） */
  bodyClass?: string;
  /** 分享图尺寸，默认 1200×630；站点封面为 1200×675 */
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title,
  description = "我将要在这里分享我的总结、想法和生活，一些东西正在慢慢构建，让我们一起在互联网中游荡，这里是我的站点yamorz。",
  image = "/images/yamorz.png",
  canonicalUrl,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  bodyClass = '',
  imageWidth = 1200,
  imageHeight = 630,
} = Astro.props;

const baseUrl = import.meta.env.SITE?.replace(/\/$/, '') || '';
const ogImage = image.startsWith('http') ? image : `${baseUrl}${image.startsWith('/') ? '' : '/'}${image}`;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={'/images/logo.webp'} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- SEO Meta Tags -->
    <meta name="description" content={description} />
    <meta name="author" content="quirkybird" />
    <meta name="theme-color" content={bodyClass === 'reading-page' ? '#faf9f5' : '#ffffff'} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={bodyClass === 'reading-page' ? '#14130f' : '#1a1a2e'} media="(prefers-color-scheme: dark)" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

  </head>
  <body class:list={[bodyClass || "dark:bg-[--bg-dark-theme-color] dark:text-[#fafafa]"]}>
    <slot />
  </body>
</html>

<script is:inline>
  // Theme handling
  const theme = localStorage.getItem('theme');
  if (theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }
</script>
