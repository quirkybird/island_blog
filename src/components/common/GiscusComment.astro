---
// Giscus Comment Component with theme sync
---

<section class="w-full pt-10 pb-6">
  <script src="https://giscus.app/client.js"
    data-repo="quirkybird/blog-yamorz-giscus"
    data-repo-id="R_kgDOK7VikA"
    data-category="Announcements"
    data-category-id="DIC_kwDOK7VikM4Cb2kU"
    data-mapping="title"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="zh-CN"
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
</section>

<script>
  // Watch for theme changes and update Giscus
  const updateGiscusTheme = () => {
    const theme = localStorage.getItem('theme');
    let giscusTheme = 'preferred_color_scheme';

    if (theme === 'dark') {
      giscusTheme = 'dark_dimmed';
    } else if (theme === 'light') {
      giscusTheme = 'light';
    } else if (theme === 'system' || !theme) {
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        giscusTheme = 'dark_dimmed';
      } else {
        giscusTheme = 'preferred_color_scheme';
      }
    }

    const iframe = document.querySelector('iframe.giscus-frame');
    if (iframe) {
      iframe.contentWindow.postMessage({
        giscus: {
          setConfig: {
            theme: giscusTheme,
          }
        }
      }, 'https://giscus.app');
    }

    // Update the data-theme attribute for new iframes
    const script = document.querySelector('script[src*="giscus"]');
    if (script) {
      script.setAttribute('data-theme', giscusTheme);
    }
  };

  // Initial theme setting
  setTimeout(updateGiscusTheme, 100);

  // Listen for theme changes
  const observer = new MutationObserver(() => {
    updateGiscusTheme();
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  });

  // Also listen for localStorage changes
  window.addEventListener('storage', (e) => {
    if (e.key === 'theme') {
      updateGiscusTheme();
    }
  });
</script>
