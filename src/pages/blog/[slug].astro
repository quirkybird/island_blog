---
import MainLayout from '../../layouts/MainLayout.astro';
import Navigation from '../../components/common/Navigation.astro';
import Footer from '../../components/common/Footer.astro';
import GiscusComment from '../../components/common/GiscusComment.astro';
import Mkd from '../../components/common/Mkd';
import SummaryCard from '../../components/common/SummaryCard';
import Toc from '../../components/common/Toc.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data, slug }) => {
    const t = (data?.title ?? '').toLowerCase();
    const s = (slug ?? '').toLowerCase();
    return !(t.startsWith('todo') || s.startsWith('todo'));
  });
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const safeData = {
  title: post.data?.title || '无标题',
  date: post.data?.date || new Date(),
  categories: post.data?.categories || [],
  tags: post.data?.tags || [],
  excerpt: post.data?.summary_text || '',
  author: post.data?.author || '未知作者',
};

const formatDate = (date) => {
  if (!date) return '无日期';
  const d = new Date(date);
  const year = d.getFullYear();
  const month = d.getMonth() + 1;
  const day = d.getDate();
  return `${year}/${month}/${day}`;
};

const isTechBlog = safeData.categories.includes('tech_blog');
const body = post.body ?? '';
const contentLength = body.length;
// 中文约 400 字/分钟，取整后至少 1 分钟
const readingMinutes = Math.max(1, Math.round(contentLength / 400));

// .mdx 文章使用 Astro 的 MDX 渲染器，才能使用博客组件；
// .md 文章继续走 Mkd，保持原有的代码块与高亮逻辑。
const isMdx = post.id.endsWith('.mdx');
const rendered = await post.render();
const MdxContent = isMdx ? rendered.Content : null;

// 目录只取二级、三级标题；没有小标题的文章不渲染目录
const flatHeadings = (rendered.headings ?? []).filter(
  (heading) => heading.depth === 2 || heading.depth === 3
);
// 以文中出现的最浅层级作为顶层（一级标题），更深的层级折叠到父级下面
const topDepth = flatHeadings.length
  ? Math.min(...flatHeadings.map((heading) => heading.depth))
  : 2;
const tocTree = [];
for (const heading of flatHeadings) {
  const node = { depth: heading.depth, slug: heading.slug, text: heading.text, children: [] };
  if (heading.depth <= topDepth || tocTree.length === 0) {
    tocTree.push(node);
  } else {
    tocTree[tocTree.length - 1].children.push(node);
  }
}
const hasToc = tocTree.length > 0;

const site = import.meta.env.SITE?.replace(/\/$/, '');
const canonicalUrl = `${site}/blog/${post.slug}`;
const publishedTime = safeData.date instanceof Date ? safeData.date.toISOString() : new Date(safeData.date).toISOString();
const description = safeData.excerpt || `${safeData.title} - quirkybird`;
const image = post.data?.cover ? (post.data.cover.startsWith('http') ? post.data.cover : `${site}${post.data.cover.startsWith('/') ? '' : '/images/cover/'}${post.data.cover}`) : undefined;

// 文章页封面：站内相对路径统一落到 /images/cover/
const cover = post.data?.cover;
const coverSrc = !cover
  ? undefined
  : cover.startsWith('http')
    ? cover
    : `${cover.startsWith('/') ? '' : '/images/cover/'}${cover}`;
---

<MainLayout
  title={`${safeData.title} - quirkybird`}
  description={description}
  image={image}
  canonicalUrl={canonicalUrl}
  ogType="article"
  publishedTime={publishedTime}
  bodyClass="reading-page"
  imageWidth={coverSrc?.endsWith('.svg') ? 1200 : undefined}
  imageHeight={coverSrc?.endsWith('.svg') ? 675 : undefined}
>
  <Navigation />

  <div class="fixed inset-x-0 top-0 z-[60] h-[2px] bg-transparent" aria-hidden="true">
    <div
      data-reading-progress
      class="h-full w-full origin-left scale-x-0 bg-[var(--accent)] transition-transform duration-150 ease-out"
    ></div>
  </div>

  <div class="h-[68.35px] lg:h-[80px]"></div>

  <main class="min-h-[calc(100vh-80px)]">
    {hasToc && <Toc headings={tocTree} />}

    <article class="reading-shell">
      {coverSrc && (
        <div class="pt-14 lg:pt-20">
          <img
            src={coverSrc}
            alt={`${safeData.title} 封面`}
            width="1200"
            height="675"
            class="block w-full rounded-xl border border-[var(--rule)] bg-[var(--paper-raised)]"
          />
        </div>
      )}

      <header class={coverSrc ? "pt-9 lg:pt-12 pb-8" : "pt-16 lg:pt-24 pb-8"}>
        {safeData.tags.length > 0 && (
          <p class="mb-5 text-[0.6875rem] font-medium uppercase tracking-[0.16em] text-[var(--faint)]">
            {safeData.tags.map((tag, i) => (
              <span>
                {i > 0 && <span class="mx-2 text-[var(--rule-strong)]">/</span>}
                {tag}
              </span>
            ))}
          </p>
        )}

        <h1 class="text-[1.9rem] lg:text-[2.6rem] font-bold leading-[1.22] tracking-[-0.022em] text-[var(--ink-strong)]">
          {safeData.title}
        </h1>

        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.8125rem] tracking-[0.02em] text-[var(--muted)]">
          <time datetime={publishedTime}>{formatDate(safeData.date)}</time>
          <span aria-hidden="true" class="text-[var(--rule-strong)]">·</span>
          <span>{contentLength.toLocaleString()} 字</span>
          <span aria-hidden="true" class="text-[var(--rule-strong)]">·</span>
          <span>约 {readingMinutes} 分钟</span>
        </div>
      </header>

      <div class="h-px w-full bg-[var(--rule)]"></div>

      {safeData.excerpt && (
        <section class="pt-9">
          <SummaryCard text={safeData.excerpt} />
        </section>
      )}

      <section class="reading-prose pt-10 pb-4" data-mkd-content>
        {isMdx ? <MdxContent /> : <Mkd markdown={body} />}
      </section>

      <footer class="mt-4 border-t border-[var(--rule)] pt-6 text-[0.8125rem] tracking-[0.02em] text-[var(--faint)]">
        <span>更新于 {formatDate(safeData.date)}</span>
      </footer>

      <GiscusComment />
    </article>
  </main>

  <Footer />
</MainLayout>

<script>
  import mediumZoom from "medium-zoom";

  const ZOOM_SELECTOR = "article .reading-prose img:not([data-no-zoom])";
  let zoomInstance = null;

  function initImageZoom() {
    const allImages = document.querySelectorAll(ZOOM_SELECTOR);
    const images = Array.from(allImages).filter((img) => !img.closest("pre, code"));
    if (!images.length) return;

    if (zoomInstance) zoomInstance.detach();
    zoomInstance = mediumZoom({
      background: "rgba(20, 19, 15, 0.88)",
      margin: 20,
    });
    zoomInstance.attach(images);
  }

  // 顶部阅读进度条
  function initReadingProgress() {
    const bar = document.querySelector<HTMLElement>("[data-reading-progress]");
    if (!bar) return;

    const update = () => {
      const article = document.querySelector("article");
      if (!article) return;
      const start = article.getBoundingClientRect().top + window.scrollY - 120;
      const total = article.scrollHeight - window.innerHeight + 120;
      const progress = total > 0 ? (window.scrollY - start) / total : 0;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  }

  document.addEventListener("astro:page-load", () => {
    initImageZoom();
    initReadingProgress();
  });
  initImageZoom();
  initReadingProgress();
</script>
